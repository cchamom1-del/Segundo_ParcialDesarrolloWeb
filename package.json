{
  "name": "autopuja-gt",
  "version": "1.0.0",
  "description": "Plataforma web de subastas de vehículos en tiempo real (caso Copart). Node.js puro + Firebase Realtime Database + SPA.",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed/run.js",
    "seed:reset": "node server/seed/run.js --reset",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
