# Copia este archivo como .env para desarrollo local (opcional)
PORT=3000
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Firebase Realtime Database (si se omite, se usa un archivo JSON local en /data)
FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
# JSON de la cuenta de servicio (en una sola línea o codificado en base64)
FIREBASE_SERVICE_ACCOUNT=
